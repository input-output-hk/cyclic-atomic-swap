%% Daemon flow for swap-daemon (see swap-daemon/src/daemon.rs)
%% Render with: mmdc -i daemon-flow.mmd -o daemon-flow.svg
flowchart TD
    %% ============================================================
    %% Lifecycle / bootstrap
    %% ============================================================
    new["Daemon::new(swap_keys, config)"]
    insert_session["daemon.insert_session(session)"]
    start_swap_session["daemon.start_swap_session(session_id)"]
    run["daemon.run() / run_shared(daemon)"]

    new --> insert_session --> start_swap_session --> run

    %% Two concurrent tokio tasks spawned by run()
    run -- "tokio::spawn (accept loop)" --> listener_accept
    run -- "tokio::spawn (event loop)" --> event_rx_recv

    %% ============================================================
    %% Networking subgraph: TCP accept + connection handling
    %% ============================================================
    subgraph NET["Networking task"]
        listener_accept["listener.accept()"]
        handle_connection["networking::handle_connection(...)"]
        listener_accept --> listener_accept
        listener_accept -- "tokio::spawn" --> handle_connection
    end

    %% ============================================================
    %% Event Channel: mpsc channel connecting tasks
    %% ============================================================
    subgraph CHAN["Event Channel (mpsc)"]
        PeerMessage(("DaemonEvent::PeerMessage"))
        ChainPoll(("DaemonEvent::ChainPoll"))
    end

    handle_connection -. "sends" .-> PeerMessage
    PeerMessage -.-> event_rx_recv

    %% Chain pollers feed the same event channel
    spawn_poller -. "sends" .-> ChainPoll
    ChainPoll -.-> event_rx_recv

    %% ============================================================
    %% Event loop subgraph
    %% ============================================================
    subgraph EVT["Event loop task"]
        event_rx_recv["event_rx.recv()"]
        handle_event["daemon.handle_event(event, event_tx)"]
        event_rx_recv --> handle_event

        %% Dispatch on event variant
        handle_event -- "DaemonEvent::PeerMessage" --> handle_session_message
        handle_event -- "ChainPoll{LockTx}" --> cp_lock["ChainPollTarget::LockTx"]
        handle_event -- "ChainPoll{LeaderSpendTx}" --> cp_leader["ChainPollTarget::LeaderSpendTx"]
        handle_event -- "ChainPoll{RefundWindow}" --> cp_refund["ChainPollTarget::RefundWindow"]

        handle_session_message["session.handle_session_message(...)"]

        %% --- Peer message branch: state machine fan-out ---
        handle_session_message -- "AdaptorPoint" --> awaitingLEC[/"SwapState::AwaitingLeaderElectionCommitments"/]
        awaitingLEC --> start_leader_election["leader_election::start_leader_election(...)"]
        handle_session_message -- "LeaderElectionCommitment" --> awaitingLEN[/"SwapState::AwaitingLeaderElectionNonces"/]
        handle_session_message -- "LeaderElectionNonce" --> compute_leader["leader_election::compute_leader(...)"]
        compute_leader --> rsSigning[/"SwapState::RefundAndSpendTxsSigning"/]
        rsSigning --> build_lock_txs["protocol::lock_funds::build_lock_txs(...)"]
        build_lock_txs --> begin_refund_signing["protocol::refund::begin_refund_signing(...)"]
        begin_refund_signing --> begin_spend_signing["protocol::spend::begin_spend_signing(...)"]

        handle_session_message -- "SchnorrNonce" --> transition_to_round_two["cryptography::multisig::transition_to_round_two(...)"]
        handle_session_message -- "PartialSignature" --> finalize_role["cryptography::multisig::finalize_role(...)"]
        finalize_role --> allSigsCheck{"all_partial_sigs_received_for_all_refund_and_spend_txs?"}
        allSigsCheck -- yes --> funding[/"SwapState::Funding"/]
        funding --> broadcast_lock[("protocol::lock_funds::broadcast_my_lock_tx(...)")]

        handle_session_message -- "LockTxBroadcast" --> lockTxLogged["log/observe lock tx"]
        handle_session_message -- "SecretReveal" --> secretReveal{"all_adaptor_secrets_received?"}
        secretReveal -- "P_leader" --> claimingMsg[/"SwapState::Claiming"/]
        secretReveal -- "P_i != leader" --> awaitingLeaderSpendMsg[/"SwapState::AwaitingLeaderSpend"/]
        claimingMsg --> broadcast_spend_msg[("protocol::spend::broadcast_my_spend_tx(...)")]
        broadcast_spend_msg --> completedMsg[/"SwapState::Completed"/]
        handle_session_message -- "SpendTxBroadcast" --> spendTxLogged["log spend tx event"]

        %% --- ChainPoll branches ---
        cp_lock -- "P_leader" --> awaitingSecrets[/"SwapState::AwaitingSecrets"/]
        cp_lock -- "P_i != leader" --> awaitingLeaderSpendCp[/"SwapState::AwaitingLeaderSpend"/]
        cp_leader --> claimingCp[/"SwapState::Claiming"/]
        claimingCp --> broadcast_spend_cp[("protocol::spend::broadcast_my_spend_tx(...)")]
        broadcast_spend_cp --> completedCp[/"SwapState::Completed"/]
        cp_refund --> broadcast_refund[("protocol::refund::broadcast_my_refund_tx(...)")]
        broadcast_refund --> refunded[/"SwapState::Refunded"/]

        %% --- Terminal vs non-terminal handling at end of handle_event ---
        handle_event --> terminalCheck{"state in {Completed, Refunded, Failed}?"}
        terminalCheck -- yes --> cancel_pollers["daemon.cancel_session_pollers(session_id)"]
        terminalCheck -- no --> maybe_spawn["daemon.maybe_spawn_pollers(session_id, event_tx)"]
        completedMsg --> terminalCheck
        completedCp --> terminalCheck
        refunded --> terminalCheck
        awaitingSecrets --> maybe_spawn
        awaitingLeaderSpendCp -- activate --> maybe_spawn
    end

    %% ============================================================
    %% Poller subgraph
    %% ============================================================
    subgraph POLL["Chain poller tasks"]
        spawn_poller["daemon.spawn_poller(session_id, target, event_tx)"]
    end
    maybe_spawn -- "tokio::spawn (per target)" --> spawn_poller
    cancel_pollers -- "abort handles" --> spawn_poller

    %% ============================================================
    %% Outgoing wire messages (re-enter event loop via peers)
    %% ============================================================
    start_leader_election       -. "WireMessage::LeaderElectionCommitment" .-> PeerMessage
    awaitingLEN                 -. "WireMessage::LeaderElectionNonce"      .-> PeerMessage
    transition_to_round_two     -. "WireMessage::PartialSignature"         .-> PeerMessage
    broadcast_lock              -. "WireMessage::LockTxBroadcast"          .-> PeerMessage
    broadcast_spend_msg         -. "WireMessage::SpendTxBroadcast"         .-> PeerMessage
    broadcast_spend_cp          -. "WireMessage::SpendTxBroadcast"         .-> PeerMessage
    awaitingLeaderSpendCp       -. "WireMessage::SecretReveal"             .-> PeerMessage
    awaitingLeaderSpendMsg      -. "WireMessage::SecretReveal"             .-> PeerMessage

    %% ============================================================
    %% Styling
    %% ============================================================
    classDef state fill:#eef,stroke:#557,stroke-width:1px;
    classDef broadcast fill:#efe,stroke:#575,stroke-width:1px;
    classDef event fill:#fee,stroke:#a55,stroke-width:1px;
    class awaitingLEC,awaitingLEN,rsSigning,funding,claimingMsg,claimingCp,completedMsg,completedCp,refunded,awaitingSecrets,awaitingLeaderSpendCp,awaitingLeaderSpendMsg state;
    class broadcast_lock,broadcast_spend_msg,broadcast_spend_cp,broadcast_refund broadcast;
    class PeerMessage,ChainPoll event;
